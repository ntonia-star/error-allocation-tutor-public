# 将本文件复制为 .env 后自行填写；禁止提交真实密钥
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_TOKENS=2400
PORT=8000
HOST=127.0.0.1
# 部署时填最终 HTTPS 域名，用于限制浏览器跨站请求
PUBLIC_ORIGIN=
# 每个来源IP每小时最多请求数，及全站模型并发上限
RATE_LIMIT_PER_HOUR=40
MAX_MODEL_CONCURRENCY=3
